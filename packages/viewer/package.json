{
  "name": "@puzlwerk/viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && tsc --ignoreConfig --noEmit --strict --skipLibCheck --module NodeNext --moduleResolution NodeNext --target ES2022 test/types/profile.ts test/types/artwork.ts test/types/stage.ts && node --test test/*.test.mjs",
    "dev": "npm run build && node demo/server.mjs"
  },
  "dependencies": {
    "three": "0.187.0",
    "@types/three": "0.187.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "CUBE_ASSEMBLER_LICENSE.txt",
    "THREE_LICENSE.txt",
    "README.md"
  ]
}
