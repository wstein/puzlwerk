{
  "name": "puzlwerk",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rescript build",
    "test": "npm run build && node --test test/*.test.mjs",
    "format:check": "rescript format --check",
    "check": "npm run format:check && npm run typecheck && npm test",
    "typecheck": "tsc -p test/types/tsconfig.json",
    "test:package": "npm run build && node scripts/verify-package.mjs",
    "docs:check": "node scripts/check-knowledge.mjs",
    "test:docs": "node --test test/knowledge.test.mjs",
    "docs:build": "npm --prefix docs/site run build",
    "docs:links": "node docs/site/check-built.mjs"
  },
  "devDependencies": {
    "rescript": "12.3.1",
    "typescript": "5.9.3"
  }
}
